# No trailing slash: in git worktrees node_modules is a symlink, which "node_modules/" does not match.
node_modules
out/
dist/
*.log
.DS_Store
*.tsbuildinfo
native/target/
native/bin/
.claude/worktrees/
# Local signing material and secrets (see docs/BUILDING.md); never commit these.
*.pfx
*.p12
.env
.env.*
electron-builder.env
# Test downloads (the speech model the offline-captions tests use, see tests/fixtures/speech/README.md).
/.cache/
# The speech helper crate builds into its own target folder.
native/speech/target/
