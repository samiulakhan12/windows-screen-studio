{
  "name": "flown",
  "productName": "Flown",
  "version": "0.3.0",
  "description": "Screen recorder and editor for Windows by Qbexel: auto zoom, smooth cursor, backgrounds, webcam and one-click export.",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "Qbexel",
    "url": "https://qbexel.com"
  },
  "homepage": "https://qbexel.com",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node scripts/build-native.mjs",
    "build:speech-host": "node scripts/build-native.mjs --speech-host",
    "fetch:test-speech": "node scripts/fetch-test-speech.mjs",
    "notices": "node scripts/notices.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:native": "vitest run -c vitest.native.config.ts",
    "test:e2e": "node tests/e2e/run-all.cjs",
    "icons": "electron --no-sandbox scripts/icons/render-icons.cjs",
    "predist": "node scripts/predist.mjs",
    "dist:win": "npm run predist && electron-vite build && electron-builder --win --x64 --config electron-builder.config.cjs && node scripts/verify-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@google/genai": "2.28.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@types/node": "22.19.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "openai": "7.32.0",
    "playwright-core": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
