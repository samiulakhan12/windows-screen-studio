{
  "name": "windows-screen-studio",
  "productName": "Screen Studio for Windows",
  "version": "0.1.0",
  "description": "Beautiful screen recordings on Windows: auto zoom, smooth cursor, backgrounds, webcam and one-click export.",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": "samiulakhan12",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
